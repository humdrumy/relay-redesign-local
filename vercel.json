{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node build-vercel.mjs",
  "outputDirectory": "public",
  "functions": {
    "api/index.mjs": {
      "maxDuration": 60
    },
    "api/queue.mjs": {
      "maxDuration": 60,
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "relay-task-dispatch"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/queue",
      "destination": "/api/queue"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
